<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MinhaBiblioteca.Views.LeitorPage"
    Title="Leitor">

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout
            Grid.Row="0"
            Padding="15"
            Spacing="4">

            <Label
                x:Name="lblTitulo"
                FontSize="22"
                FontAttributes="Bold"/>

            <Label
                x:Name="lblAutor"
                FontSize="14"/>

        </VerticalStackLayout>

        <WebView
            Grid.Row="1"
            x:Name="pdfWebView"/>

    </Grid>

</ContentPage>